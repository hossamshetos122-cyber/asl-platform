# ============================================================
# ASL Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# Database
# For local development (SQLite): DATABASE_URL="file:./dev.db"
# For production (PostgreSQL):    DATABASE_URL="postgresql://user:password@host:5432/asl_db?schema=public"
DATABASE_URL="file:./dev.db"

# Session secret — used for signing session tokens in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. Ignored in development.
SESSION_SECRET=""

# Node environment
NODE_ENV="development"
