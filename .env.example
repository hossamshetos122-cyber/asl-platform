# ============================================================
# ASL Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# Database
# For local development (SQLite): DATABASE_URL="file:./dev.db"
# For production (PostgreSQL):    DATABASE_URL="postgresql://user:password@host:5432/asl_db?schema=public"
DATABASE_URL="file:./dev.db"

# Session secret — used for signing session tokens in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. Ignored in development.
SESSION_SECRET=""

# Public URL of the deployed app (used in email links).
# e.g. APP_ORIGIN="https://your-app.vercel.app"
APP_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------
# Email delivery (for password reset + email verification)
# ------------------------------------------------------------
# Option A — Resend (recommended): https://resend.com
# Get an API key from the Resend dashboard, add your domain, then set:
RESEND_API_KEY=""
# The "From" address/name, e.g. "Alexandria League <no-reply@yourdomain.com>".
# If empty, Resend's onboarding@resend.dev sender is used until a domain is added.
MAIL_FROM=""

# Option B — any Resend-compatible JSON API (custom endpoint):
MAIL_API_URL=""
MAIL_API_KEY=""

# ------------------------------------------------------------
# Branding defaults (used until a SiteConfig row is set in /admin/settings)
# ------------------------------------------------------------
NEXT_PUBLIC_LEAGUE_NAME="دوري نجوم الإسكندرية للهواة"
NEXT_PUBLIC_LEAGUE_NAME_EN="Alexandria Amateur League"
NEXT_PUBLIC_CITY_NAME="الإسكندرية"
NEXT_PUBLIC_LEAGUE_LOGO="/images/league-logo.jpg"
NEXT_PUBLIC_PRIMARY_COLOR="#0A2647"
NEXT_PUBLIC_ACCENT_COLOR="#FF6B35"

# Node environment
NODE_ENV="development"
