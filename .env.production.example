# Production environment configuration
DATABASE_URL="postgresql://user:password@host:5432/asl_db?schema=public"
SESSION_SECRET="replace-with-random-64-char-hex-string"
APP_ORIGIN="https://your-app.vercel.app"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="Your League <no-reply@yourdomain.com>"

# Branding defaults (overridden by /admin/settings once configured)
NEXT_PUBLIC_LEAGUE_NAME="دوري نجوم الإسكندرية للهواة"
NEXT_PUBLIC_PRIMARY_COLOR="#0A2647"
NEXT_PUBLIC_ACCENT_COLOR="#FF6B35"

NODE_ENV="production"
