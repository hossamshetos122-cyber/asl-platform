    "qa:live": "node scripts/qa/verify-live.cjs",
    "qa:full": "node scripts/qa/verify-phase3.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "^15.5.24",
    "pg": "^8.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^25.9.0"
